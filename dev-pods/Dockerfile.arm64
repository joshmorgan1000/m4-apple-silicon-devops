FROM --platform=linux/arm64 ubuntu:22.04

USER root
ENV DEBIAN_FRONTEND=noninteractive

# 1. Install system dependencies & dev tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-transport-https ca-certificates gnupg curl wget \
    build-essential clang llvm cmake ninja-build pkg-config \
    rustc cargo liblz4-dev libzstd-dev \
    perl python3 python3-pip python3-dev python3-setuptools \
    openjdk-17-jdk maven nodejs npm libsnappy-dev libjemalloc-dev \
    sudo git ssh vim nano bash \
    # GPU / 3D libs
    mesa-common-dev libvulkan-dev libglfw3-dev \
    # wasm tools
    wabt binaryen fontconfig \
    # Jenkins dependencies
    fontconfig

# 2. Install Go 1.23.6 from prebuilt tarball
WORKDIR /tmp
RUN curl -fsSLo go1.23.6.linux-arm64.tar.gz \
      https://dl.google.com/go/go1.23.6.linux-arm64.tar.gz \
    && rm -rf /usr/local/go \
    && tar -C /usr/local -xzf go1.23.6.linux-arm64.tar.gz \
    && rm go1.23.6.linux-arm64.tar.gz
ENV GOROOT=/usr/local/go
ENV PATH=$PATH:/usr/local/go/bin

# 3. Python packages
RUN pip3 install --no-cache-dir tensorflow
RUN pip3 install --no-cache-dir torch
RUN pip3 install --no-cache-dir \
    keras tqdm transformers umap-learn \
    scikit-learn pybind11 pandas pymilvus
RUN pip3 install --no-cache-dir \
    numpy scipy matplotlib scikit-image \
    grpcio huggingface_hub \
    pymysql psutil protobuf opencv-python \
    && rm -rf /root/.cache/pip

WORKDIR /tmp
RUN git clone --depth 1 --branch v4.3.4 https://github.com/zeromq/libzmq.git
WORKDIR /tmp/libzmq
RUN mkdir build
WORKDIR /tmp/libzmq/build
RUN cmake .. && make -j4 && make install

WORKDIR /tmp
RUN git clone https://github.com/zeromq/cppzmq.git
WORKDIR /tmp/cppzmq
RUN mkdir build
WORKDIR /tmp/cppzmq/build
RUN cmake .. && make -j4 && make install

WORKDIR /tmp
RUN git clone https://github.com/openssl/openssl.git
WORKDIR /tmp/openssl
RUN ./Configure && make -j4 && make install

# Expose some ports for testing
EXPOSE 8080 8081 8888 5000

# Keeps the container alive
CMD ["tail", "-f", "/dev/null"]